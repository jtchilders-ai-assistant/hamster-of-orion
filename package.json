{
  "name": "hamster-of-orion",
  "version": "0.1.0",
  "private": true,
  "description": "Hamster of Orion — a turn-based 4X space strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "check-design": "npx tsx scripts/check-design-compliance.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
